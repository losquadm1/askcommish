---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
---

<Layout title="Ask Commish">
  <Container>
    <div class="ask">
      <h1>Ask The Commissioner</h1>
      <button class="commish">
        <img src="/images/the commissioner.webp" alt="The All Knowing commissioner" />
      </button>
      <p id="track-title"></p>
      <button id="quality-toggle" type="button" aria-label="Switch to HD">sd</button>
    </div>
    
    <button id="bg-toggle" aria-label="Pause background spin">
      <img id="bg-toggle-icon" src="/images/pause.svg" alt="Pause" />
    </button>
  </Container>
</Layout>

<script>
  const tracks = [
    { file: "ask next time.mp3", title: "Ask Next Time", weight: 1 },
    { file: "follow the seahorse.mp3", title: "Follow the Seahorse", weight: 1 },
    { file: "i dont think so.mp3", title: "I Don't Think So", weight: 1 },
    { file: "i see a new sauce in your future.mp3", title: "I See a New Sauce in Your Future", weight: 1 },
    { file: "maybe some day.mp3", title: "Maybe Some Day", weight: 1 },
    { file: "neither.mp3", title: "Neither", weight: 1 },
    { file: "no.mp3", title: "No", weight: 1.33 },
    { file: "nothing1.mp3", title: "Nothing", weight: 0.5 },
    { file: "nothing2.mp3", title: "Nothing", weight: 0.5 },
    { file: "try asking again.mp3", title: "Try Asking Again", weight: 1 },
    { file: "yes.mp3", title: "Yes", weight: 1.33 },
    { file: "you could not get to the top from sitting on your bottom.mp3", title: "You Cannot Not Get to the Top from Sitting on Your Bottom", weight: 1 },
  ];

  let lastTrackFile: string | null = null;

  const pickWeightedTrack = (pool: typeof tracks) => {
    const totalWeight = pool.reduce((sum, track) => sum + track.weight, 0);
    let randomWeight = Math.random() * totalWeight;

    for (const track of pool) {
      randomWeight -= track.weight;
      if (randomWeight <= 0) {
        return track;
      }
    }

    return pool[pool.length - 1];
  };

  const pickRandomTrack = () => {
    const availableTracks = tracks.filter((track) => track.file !== lastTrackFile);
    const track = pickWeightedTrack(availableTracks.length > 0 ? availableTracks : tracks);

    lastTrackFile = track.file;

    return track;
  };

  const button = document.querySelector(".commish");
  const titleEl = document.getElementById("track-title");
  const qualityToggle = document.getElementById("quality-toggle") as HTMLButtonElement;
  const storageKeys = {
    qualityMode: "askcommish.qualityMode",
    bgPaused: "askcommish.bgPaused",
  };
  let qualityMode: "sd" | "hd" = "sd";
  const sdDefaultGain = 2.5;
  const sdTrackGainByFile: Record<string, number> = {
    "i dont think so.mp3": 5,
    "no.mp3": 1.75,
    "nothing1.mp3": 2,
    "nothing2.mp3": 2,
    "you could not get to the top from sitting on your bottom.mp3": 1.15,
    "follow the seahorse.mp3": 2,
  };
  let currentAudio: HTMLAudioElement | null = null;
  let audioContext: AudioContext | null = null;
  let currentSourceNode: MediaElementAudioSourceNode | null = null;
  let currentGainNode: GainNode | null = null;

  button?.addEventListener("click", () => {
    const track = pickRandomTrack();

    if (currentAudio) {
      currentAudio.pause();
      currentAudio.currentTime = 0;
    }

    if (currentSourceNode) {
      currentSourceNode.disconnect();
      currentSourceNode = null;
    }

    if (currentGainNode) {
      currentGainNode.disconnect();
      currentGainNode = null;
    }

    titleEl!.style.opacity = "0";

    const audioBasePath = qualityMode === "sd" ? "/audio/crunch" : "/audio";
    currentAudio = new Audio(`${audioBasePath}/${encodeURIComponent(track.file)}`);

    if (qualityMode === "sd") {
      audioContext ??= new AudioContext();
      if (audioContext.state === "suspended") {
        void audioContext.resume();
      }

      currentSourceNode = audioContext.createMediaElementSource(currentAudio);
      currentGainNode = audioContext.createGain();
      currentGainNode.gain.value = sdTrackGainByFile[track.file] ?? sdDefaultGain;
      currentSourceNode.connect(currentGainNode);
      currentGainNode.connect(audioContext.destination);
    }

    currentAudio.play();

    titleEl!.textContent = track.title;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        titleEl!.style.opacity = "1";
      });
    });

    button!.classList.add("playing");

    currentAudio.addEventListener("ended", () => {
      titleEl!.style.opacity = "0";
      button!.classList.remove("playing");
    });
  });

  const bgToggle = document.getElementById("bg-toggle") as HTMLButtonElement;
  const bgIcon = document.getElementById("bg-toggle-icon") as HTMLImageElement;
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let bgPaused = prefersReducedMotion;

  const applyQualityState = () => {
    qualityToggle.textContent = qualityMode;
    qualityToggle.setAttribute("aria-label", qualityMode === "sd" ? "Switch to HD" : "Switch to SD");
  };

  try {
    const savedQualityMode = localStorage.getItem(storageKeys.qualityMode);
    if (savedQualityMode === "sd" || savedQualityMode === "hd") {
      qualityMode = savedQualityMode;
    }

    const savedBgPaused = localStorage.getItem(storageKeys.bgPaused);
    if (savedBgPaused === "true" || savedBgPaused === "false") {
      bgPaused = savedBgPaused === "true";
    }
  } catch {
    // Ignore storage access errors (private mode or restricted storage).
  }

  applyQualityState();

  const applyBgState = () => {
    document.body.style.setProperty("--spin-state", bgPaused ? "paused" : "running");
    bgIcon.src = bgPaused ? "/images/play.svg" : "/images/pause.svg";
    bgToggle.setAttribute("aria-label", bgPaused ? "Play background spin" : "Pause background spin");
  };

  applyBgState();

  bgToggle.addEventListener("click", () => {
    bgPaused = !bgPaused;
    applyBgState();

    try {
      localStorage.setItem(storageKeys.bgPaused, String(bgPaused));
    } catch {
      // Ignore storage write errors.
    }
  });

  qualityToggle.addEventListener("click", () => {
    const isSd = qualityToggle.textContent?.trim().toLowerCase() === "sd";
    qualityMode = isSd ? "hd" : "sd";
    applyQualityState();

    try {
      localStorage.setItem(storageKeys.qualityMode, qualityMode);
    } catch {
      // Ignore storage write errors.
    }
  });
</script>

<style>

  h1{
    font-size: 2.5rem;
    margin-bottom: -20px;
    line-height: 1.25;
  }

  p{
    margin-top: -20px;
  }

  .ask {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    min-height: 100vh;
    padding-top: 60px;
    padding-bottom: 40px;
  }
  @media (max-width: 700px) {
    .ask {
      padding-top: 10px;
    }

  }

  .commish {
    background: none;
    border: none;
    cursor: pointer;
    padding: 1.5rem;
    transition: filter 0.4s ease;
  }

  .commish.playing {
    filter: drop-shadow(0 0 18px rgba(202, 226, 255, 0.85)) drop-shadow(0 0 40px rgba(152, 188, 255, 0.5));
  }

  @media (hover: hover) {
    .commish:hover {
      filter: drop-shadow(0 0 18px rgba(202, 226, 255, 0.85)) drop-shadow(0 0 40px rgba(152, 188, 255, 0.5));
    }
  }

  .commish img {
    width: 400px;
    height: auto;
  }

  #track-title {
    font-size: 1.25rem;
    font-weight: bold;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  #track-title::before { content: "\201C"; }
  #track-title::after  { content: "\201D"; }

  #quality-toggle,
  #bg-toggle {
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  #quality-toggle:hover,
  #bg-toggle:hover {
    opacity: 1;
  }

  #quality-toggle {
    position: fixed;
    left: 1rem;
    bottom: calc(1rem + 24px + 0.75rem);
    width: 35px;
    height: 35px;
    display: grid;
    place-items: center;
    border: none;
    background: #ffffff;
    color: #000000;
    text-transform: uppercase;
    text-align: center;
    line-height: 1;
    padding: 0;
    border-radius: 2px;
    cursor: pointer;
    font-weight: 900;
    font-size: 1rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    letter-spacing: 0;
    mix-blend-mode: screen;
  }

  body {
    margin: 0;
    overflow-x: hidden;
  }

  body::before {
    content: "";
    position: fixed;
    inset: -100%;
    width: 300%;
    height: 300%;
    background: url("/images/spacebg.jpg") no-repeat center center;
    background-size: cover;
    opacity: 0.4;
    animation: slowspin 600s linear infinite;
    animation-play-state: var(--spin-state, running);
    z-index: -1;
  }

  @keyframes slowspin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    body { --spin-state: paused; }
  }

  #bg-toggle {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  #bg-toggle img {
    width: 24px;
    height: 24px;
  }
</style>
